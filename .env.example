# ==========================================
# SCUT-Shop 环境变量配置
# 复制此文件为 .env 后修改: cp .env.example .env
# ==========================================

# --- 数据库 (MySQL) ---
MYSQL_ROOT_PASSWORD=请修改为强密码
MYSQL_DATABASE=scut_shop
MYSQL_USER=scut_user
MYSQL_PASSWORD=请修改为强密码
DB_HOST=db
DB_PORT=3306
DB_NAME=scut_shop
DB_USER=scut_user
DB_PASSWORD=请修改为强密码

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- JWT ---
JWT_SECRET=请替换为至少32位的随机字符串
JWT_EXPIRES_MIN=60
JWT_REFRESH_EXPIRES_DAYS=7

# --- 管理员初始账号 ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@shop.local
ADMIN_PASSWORD=请修改为强密码

# --- 支付 (mock=模拟, 生产环境需对接真实支付) ---
PAYMENT_MOCK=true

# --- 邮件 (开发环境用 MailHog, 生产环境填真实 SMTP) ---
MAIL_HOST=mailhog
MAIL_SMTP_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_TLS=false
MAIL_SSL=false

# --- 邮箱激活 (开发环境建议关闭) ---
EMAIL_ACTIVATION_ENABLED=false

# --- 前端地址 ---
FRONTEND_BASE=http://localhost:3000
